meta {
  name: Add User to Org
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/admin/orgs/:orgId/members
  body: json
  auth: none
}

params:path {
  orgId: <paste-org-id-here>
}

headers {
  X-API-Key: {{adminApiKey}}
  Content-Type: application/json
}

body:json {
  {
    "userId": "<paste-user-id>",
    "roles": ["MEMBER"]
  }
}
